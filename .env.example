# Finnhub API Key (for company news, sentiment analysis)
# Get your free API key at: https://finnhub.io/register
FINNHUB_API_KEY=demo
VITE_FINNHUB_API_KEY=demo

# OpenAI API Key (for AI analysis and market intelligence)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Twitter API v2 credentials (for social media analysis)
# Get your credentials at: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Replace 'demo' with your actual API keys
# Example: FINNHUB_API_KEY=ct1ab12ad3iabc123abc
# Example: OPENAI_API_KEY=sk-...
